{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "outDir": "./bin/ts",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["runtime-js/src/**/*", "stdlib/*/src/**/*", "examples/*/src/**/*"],
  "exclude": ["node_modules", "build"]
}
