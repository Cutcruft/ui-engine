{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-engine/screen.schema.json",
  "title": "ui-engine screen.yaml",
  "type": "object",
  "required": ["name"],
  "properties": {
    "screen": { "type": "string" },
    "name": { "type": "string" },
    "root": { "$ref": "#/$defs/node" },
    "layout": { "$ref": "#/$defs/node" },
    "animate": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "duration": { "type": "integer" },
            "easing": { "type": "string" },
            "direction": { "type": "string" },
            "delay": { "type": "integer" }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "component": { "type": "string" },
        "layout": { "enum": ["row", "column", "grid", ""] },
        "key": { "type": "string" },
        "props": { "type": "object", "additionalProperties": { "type": "string" } },
        "bind": { "type": "string" },
        "label": { "type": "string" },
        "text": { "type": "string" },
        "if": { "type": "string" },
        "repeat": { "type": "string" },
        "animate": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "duration": { "type": "integer" },
                "easing": { "type": "string" },
                "direction": { "type": "string" },
                "delay": { "type": "integer" }
              },
              "additionalProperties": true
            }
          ]
        },
        "on": { "type": "object", "additionalProperties": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
